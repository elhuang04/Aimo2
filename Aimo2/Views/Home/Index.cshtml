@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/css/styles.css">
<div class="popup" style="background-color: rgba(63,63,63,.8);
    color: white;
    left: 0;
    margin: auto;
    padding: 20px;
    position: absolute;
    right: 0;
    top: 72px;
    width: 730px;
    z-index: 3;">
    <!-- cancel button-->
    <!--<button type="submit" name="cancel" id="close" class="default-input sale-text-req">&times;</button> -->
    
    <div id="pop">
        <input id="checkbox1" name="checkbox" type="checkbox" required class="default-input sale-text-req" onchange='handleChange(this);' />
        <label for="checkbox"> I have read and consent to aimo!’s @Html.ActionLink("Terms of Use","Policies","Home", null, new { @class = "page-scroll" }) and @Html.ActionLink("Privacy Policy","Policies","Home", null, new { @class = "page-scroll" }).</label>
    </div>
    <div id="pop">
        <input id="checkbox2" name="checkbox" type="checkbox" required class="default-input sale-text-req" onchange='handleChange(this);' />
        <label for="checkbox"> By joining the aimo! community, you agree to comply with our @Html.ActionLink("Community Guidelines","Policies","Home", null, new { @class = "page-scroll" }).</label>
    </div>
    <input type="submit" name="Submit" id="subok" class="default-input sale-text-req" value="Submit">
</div>
<script>
     
     checkTerms() {
     
      if($('input[type="checkbox"]').is(":checked")
      {
         //$('input[type="submit"]').attr('disabled', 'disabled');
            $('input[type="submit"]').removeAttr('disabled');
            document.getElementById("subok").removeAttr('disabled');
     }
     else
     {
         $('input[type="submit"]').removeAttr('disabled');
     }
 }
    
 function handleChange(checkbox) {
    if(checkbox.checked == true){
        document.getElementById("subok").removeAttribute("disabled");
    }else{
        document.getElementById("subok").setAttribute("disabled", "disabled");
   }
}
</script>
