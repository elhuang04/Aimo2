@model Aimo2.Models.Explore

@{
    ViewData["Title"] = "Claim";
    int PeopleClaim = 0;
    int PeopleClaimPlus = 0;
    if (ViewData["People_Claimed"] is not null)
    {
        try
        {
            PeopleClaim = int.Parse(ViewData["People_Claimed"].ToString());
            PeopleClaimPlus = PeopleClaim + 1;
        }
        catch(Exception e)
        {
            Console.Write(e.Message);
        }
    }
}

<h1>Claim</h1>

<h4>Explore</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Claim">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            @*1.Task Title*@
            <div class="form-group">
                @*<label asp-for="Task_Title" class="control-label" style="display:none"></label>*@
                <input type="hidden" asp-for="Task_Title" class="form-control" />
                <span asp-validation-for="Task_Title" class="text-danger"></span>
            </div>
            @*2.Requester*@
            <div class="form-group">
                @*<label asp-for="Requester" class="control-label"></label>*@
                <input type="hidden" asp-for="Requester" class="form-control" />
                <span asp-validation-for="Requester" class="text-danger"></span>
            </div>
            @*3.People Needed*@
            <div class="form-group">
                @*<label asp-for="People_Needed" class="control-label"></label>*@
                <input type="hidden" asp-for="People_Needed" class="form-control" />
                <span asp-validation-for="People_Needed" class="text-danger"></span>
            </div>
            @*4.Due Date*@
            <div class="form-group">
                @*<label asp-for="Due_Date" class="control-label"></label>*@
                <input type="hidden" asp-for="Due_Date" class="form-control" />
                <span asp-validation-for="Due_Date" class="text-danger"></span>
            </div>
            @*5.Description*@
            <div class="form-group">
                @*<label asp-for="Description" class="control-label"></label>*@
                <input type="hidden" asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            @*6.Status*@
            <div class="form-group">
                @*<label asp-for="Status" class="control-label"></label>*@
                <input type="hidden" asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                @* <label asp-for="People_Claimed" class="control-label"></label>
                <input asp-for="People_Claimed" class="form-control"/>*@
                <span asp-validation-for="People_Claimed" class="text-danger"></span>
                <p>Current total claim:@PeopleClaim</p>
                <input type="hidden" asp-for="People_Claimed" value="@PeopleClaimPlus" />
            </div>
            <div class="form-group">
                <input type="submit" value="Confirm Claim" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
