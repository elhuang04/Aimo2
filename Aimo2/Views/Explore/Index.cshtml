@model IEnumerable<Aimo.Models.Explore>

@{
    ViewData["Title"] = "Index";
    DateTime sdate = DateTime.Today;
    DateTime edate = DateTime.Today.AddMonths(3);
    //display selected dates values, may not be the best method
    string startdt ="";
    if (TempData.ContainsKey("startdt")  )
        {          
            if (TempData["startdt"] != null)
            startdt =  TempData["startdt"].ToString();
        }
    string enddt = "";
    if (TempData.ContainsKey("enddt"))
    { 
        if (TempData["enddt"] != null)
        enddt = TempData["enddt"].ToString();
    }
    //TempData.Keep("startdt");
   // TempData.Keep("enddt");
}
 

<h1>Index</h1>
  
<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-controller="Explore" asp-action="Index" name="fdate">
    <p>
        Start: <input type="date" name="StartDate" value="@startdt" required />
        End: <input type="date" name="EndDate" value="@enddt" required  />
        <input type="submit" value="Filter" formaction=@Url.Action("FilterbyDate") />
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.People_Needed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Requester)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accepted_By)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Due_Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.People_Needed)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Requester)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Accepted_By)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Due_Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
