@model IEnumerable<Aimo2.Models.Explore>
<link rel="stylesheet" href="~/css/styles.css">

<style>
    body {
        background-color: #2A3065;
    }
</style>
<head></head>
<body>
@{
    ViewData["Title"] = "Index";
    DateTime sdate = DateTime.Today;
    DateTime edate = DateTime.Today.AddMonths(3);
    //display selected dates values, may not be the best method
    string startdt ="";
    if (TempData.ContainsKey("startdt")  )
        {          
            if (TempData["startdt"] != null)
            startdt =  TempData["startdt"].ToString();
        }
    string enddt = "";
    if (TempData.ContainsKey("enddt"))
    { 
        if (TempData["enddt"] != null)
        enddt = TempData["enddt"].ToString();
    }
}
    <form asp-controller="Explore" asp-action="Index" name="fdate">
        <b3 style ="color:white";>
        Start: <input type="date" name="StartDate" value="@startdt" required />
        End: <input type="date" name="EndDate" value="@enddt" required  />
        <input type="submit" value="Filter" formaction=@Url.Action("FilterbyDate") />
    </b3>
</form>

<table class="table">
